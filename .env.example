# Entorno de ejecución
NODE_ENV=production

# API (apps/api)
PORT=3001
LOG_LEVEL=info
NITRO_SHUTDOWN_TIMEOUT=5

# SMTP del formulario de contacto (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# Web (apps/web)
# NUXT_API_TARGET se lee AL COMPILAR apps/web (routeRules del proxy SSR).
# En local: http://localhost:3001 · en Compose: http://api:3001 (ver Dockerfile).
NUXT_API_TARGET=http://localhost:3001
# Se puede cambiar en runtime; canonical y og:url lo reflejan por ruta.
NUXT_PUBLIC_SITE_URL=https://tu-dominio.com

# CORS (opcional; por defecto mismo origen mediante /api)
CORS_ORIGINS=
