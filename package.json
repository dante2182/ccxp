{
  "name": "ccxp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @ccxp/web dev",
    "build": "pnpm -r build",
    "generate": "pnpm --filter @ccxp/web generate",
    "preview": "pnpm --filter @ccxp/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:up": "docker compose -f deploy/docker-compose.yml up -d --build",
    "deploy:down": "docker compose -f deploy/docker-compose.yml down",
    "deploy:restart": "docker compose -f deploy/docker-compose.yml restart",
    "deploy:logs": "docker compose -f deploy/docker-compose.yml logs -f",
    "deploy:ps": "docker compose -f deploy/docker-compose.yml ps"
  },
  "devDependencies": {
    "@ccxp/config": "workspace:*",
    "prettier": "3.10.1"
  }
}
